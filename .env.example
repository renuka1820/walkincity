# Copy to .env.local for your computer, and add the same values in Netlify →
# Site configuration → Environment variables.

# Supabase → Project Settings → API (or "Connect")
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx   # older projects: the "anon public" key
SUPABASE_SERVICE_ROLE_KEY=                                # "service_role" / secret key — NEVER share. Needed only for payments.

# Your live address (no trailing slash), e.g. https://walkincity.netlify.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Tracking (Phase 5) — leave blank until you have them
NEXT_PUBLIC_GA_ID=                 # G-XXXXXXXXXX
NEXT_PUBLIC_CLARITY_ID=            # from clarity.microsoft.com → Settings → Setup
NEXT_PUBLIC_GSC_VERIFICATION=      # Search Console "HTML tag" content value

# Razorpay (Phase 6, Week 4) — leave blank until KYC is approved
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
